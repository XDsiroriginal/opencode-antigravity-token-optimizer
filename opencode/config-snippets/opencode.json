{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
  "small_model": "openrouter/nvidia/nemotron-3.5-lightning:free",
  "instructions": [
    "C:\\Users\\XDsir\\.config\\opencode\\instructions.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "*plink*": "allow",
      "ssh *": "allow",
      "ssh.exe *": "allow",
      "*paramiko*": "allow"
    }
  },
  "provider": {
    "cline": {
      "name": "Cline AI (Free Models)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.cline.bot/api/v1",
        "apiKey": "sk_YOUR_CLINE_API_KEY"
      },
      "models": {
        "reflection/beam-free": {
          "name": "Reflection Beam (Cline Free Reasoning)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 64000,
            "output": 8192
          }
        },
        "nvidia/nemotron-3.5-lightning-free": {
          "name": "Nemotron 3.5 Lightning (Cline Free Reasoning)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 64000,
            "output": 8192
          }
        },
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron 3 Ultra 550B (Cline Flagship Reasoning, Free)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 64000,
            "output": 16000
          }
        },
        "nvidia/nemotron-3.5-super-vl:free": {
          "name": "Nemotron 3.5 Super-VL (Cline Multimodal Vision & Code, Free)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 64000,
            "output": 8192
          }
        },
        "openrouter/free": {
          "name": "Auto Free Router (Cline Free)",
          "tool_call": true,
          "limit": {
            "context": 64000,
            "output": 8192
          }
        }
      }
    },
    "openrouter": {
      "name": "OpenRouter (Free Flagships)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "sk-or-v1-YOUR_OPENROUTER_API_KEY"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "NVIDIA Nemotron 3 Ultra 550B (Flagship Reasoning, Free)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 64000,
            "output": 16000
          }
        },
        "nvidia/nemotron-3.5-lightning:free": {
          "name": "NVIDIA Nemotron 3.5 Lightning (Fast Reasoning, Free)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 64000,
            "output": 8192
          }
        },
        "nvidia/nemotron-3.5-super-vl:free": {
          "name": "NVIDIA Nemotron 3.5 Super-VL (Vision & Code, Free)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 64000,
            "output": 8192
          }
        },
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free": {
          "name": "NVIDIA Nemotron 3 Nano Omni 30B (Reasoning, Free)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "cohere/north-mini-code:free": {
          "name": "Cohere North Mini Code (Coding Specialist, Free)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "pollinations": {
      "name": "Pollinations AI (No Key Needed)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://text.pollinations.ai/openai",
        "apiKey": "anonymous"
      },
      "models": {
        "openai-fast": {
          "name": "GPT-OSS 20B Reasoning (Free, No Auth)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "groq": {
      "name": "Groq Cloud (Free Tier)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "gsk_YOUR_GROQ_API_KEY"
      },
      "models": {
        "llama-3.3-70b-versatile": {
          "name": "Llama 3.3 70B Versatile (Groq)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "ollama": {
      "name": "Ollama (local/network)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "north-mini-code-1.0:latest": {
          "name": "North Mini Code 1.0 (30B MoE, agentic)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 32768
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B MoE (fast, non-thinking)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 32768
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "qwen2.5:7b": {
          "name": "Qwen2.5 7B (light tasks)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  },
  "plugin": [
    "openslimedit",
    "@tarquinen/opencode-dcp"
  ],
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      },
      "docslim": {
        "type": "local",
        "command": [
          "docslim.cmd",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      }
    }
  }
}

